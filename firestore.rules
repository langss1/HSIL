rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc(request.auth.uid).data.role == 'admin'
        && userDoc(request.auth.uid).data.isActive == true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validUserPayload() {
      return request.resource.data.keys().hasAll([
        'userId', 'nik', 'name', 'email', 'role', 'department', 'position',
        'shiftStart', 'shiftEnd', 'isActive', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.userId is string
      && request.resource.data.userId == request.resource.id
      && request.resource.data.nik.matches('^\\d{10}$')
      && request.resource.data.role in ['employee', 'admin']
      && request.resource.data.isActive is bool;
    }

    function validAttendancePayload() {
      return request.resource.data.keys().hasAll([
        'attendanceId', 'userId', 'date', 'status', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.attendanceId == request.resource.id
      && request.resource.data.userId == request.auth.uid
      && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
      && request.resource.data.status in ['hadir', 'telat', 'izin', 'alpha'];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() && validUserPayload();
      allow update: if (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'isActive', 'nik', 'createdAt'])
      ) || (isAdmin() && validUserPayload());
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && validAttendancePayload();
      allow update: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin())
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['attendanceId', 'userId', 'createdAt']);
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, delete: if isAdmin();
    }

    match /izin/{izinId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /office_config/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
